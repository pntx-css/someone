{
  "framework": "vite",
  "rewrites": [
    { "source": "/admin", "destination": "/" },
    { "source": "/api/:path*", "destination": "/api/handler?__api_path=:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
